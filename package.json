  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "preview": "vite preview",
    "start": "node server.js",
    "sonar": "sonar-scanner",
    "sonar:local": "sonar-scanner -Dsonar.host.url=http://localhost:9000",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fileutils": "vitest run src/utils/fileUtils.test.ts --reporter=verbose",
    "test:fileutils:log": "vitest run src/utils/fileUtils.test.ts > test-output.log",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage --reporter=verbose && node scripts/normalize-coverage-paths.js",
    "test:update": "vitest --update",
    "test:ci": "vitest run --coverage --reporter=verbose --reporter=junit && node scripts/normalize-coverage-paths.js && node scripts/convert-test-report.js && node scripts/validate-test-report.js",
    "convert:test-report": "node scripts/convert-test-report.js",
    "validate:test-report": "node scripts/validate-test-report.js",
    "test:local-pipeline": "powershell -ExecutionPolicy Bypass -File .\\scripts\\test-local-pipeline.ps1"
  },
