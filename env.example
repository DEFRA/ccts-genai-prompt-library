# Environment Variables for Prompt Library Application

# Test Configuration
# Note: For testing, you can set TEST_PASSWORD environment variable
# If not set, the test config will use an empty string as fallback
TEST_PASSWORD=

# OpenAI Configuration
VITE_OPENAI_MODEL=gpt-4o
VITE_DEFAULT_API=mistral
VITE_OPENAI_BASE_URL=https://api.openai.com/v1

# Azure OpenAI Configuration
VITE_AZURE_OPENAI_ENDPOINT=https://your-azure-endpoint.com
VITE_AZURE_OPENAI_DEPLOYMENT_ID=gpt-4o

# Bing Search Configuration
VITE_BING_SEARCH_LOCATION=global

# Note: Replace placeholder values with your actual configuration
# This file should not contain real credentials - use .env for that 